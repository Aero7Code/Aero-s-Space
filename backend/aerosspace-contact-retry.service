[Unit]
Description=Retry Aero's Space email notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aero_web
Group=aero_web
WorkingDirectory=/opt/aerosspace-contact
EnvironmentFile=/etc/aerosspace-contact.env
ExecStart=/usr/bin/python3 /opt/aerosspace-contact/server.py --retry-pending
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aerosspace-contact
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
