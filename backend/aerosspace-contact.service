[Unit]
Description=Aero's Space contact form receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aero_web
Group=aero_web
WorkingDirectory=/opt/aerosspace-contact
EnvironmentFile=/etc/aerosspace-contact.env
ExecStart=/usr/bin/python3 /opt/aerosspace-contact/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aerosspace-contact
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
