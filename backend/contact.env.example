# Place real values in /etc/aerosspace-contact.env with mode 0600.
DATABASE_PATH=/var/lib/aerosspace-contact/messages.sqlite3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=your-address@gmail.com
NOTIFY_TO=your-address@gmail.com
